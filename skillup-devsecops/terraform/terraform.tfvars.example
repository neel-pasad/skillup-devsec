# Copy to terraform.tfvars (git-ignored) and fill in. Never commit real values.
aws_region       = "ap-south-1"
allowed_ssh_cidr = "203.0.113.10/32"   # your public IP /32  (find it at https://checkip.amazonaws.com)
key_name         = "skillup-key"       # an existing EC2 key pair name
attach_ecr_role  = true
