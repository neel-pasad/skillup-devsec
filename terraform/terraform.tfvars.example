# Copy to terraform.tfvars (which is git-ignored) and fill in. Never commit real values.
aws_region       = "ap-south-1"
docker_image     = "YOUR_DOCKERHUB_USER/skillup:latest"
allowed_ssh_cidr = "203.0.113.10/32"   # your public IP /32
key_name         = ""                   # optional EC2 key pair name
